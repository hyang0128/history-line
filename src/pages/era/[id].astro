---
import Base from '@/layouts/Base.astro';
import NodeList from '@/components/NodeList.astro';
import Timeline from '@/components/Timeline/Timeline.astro';
import { getAllNodes, getEras, formatRange } from '@/lib/nodes';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('eras');
  return all.map((e) => ({ params: { id: e.id }, props: { entry: e } }));
}
const { entry } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { dynasties } = await getEras();
const nodes = await getAllNodes();
const isEra = entry.data.type === 'era';
const mine = nodes.filter((n) =>
  isEra ? n.entry.data.era === entry.id : n.entry.data.dynasty === entry.id,
);
const children = isEra ? dynasties.filter((d) => d.data.parent === entry.id) : [];
const parent = !isEra && entry.data.parent ? await getCollection('eras').then((a) => a.find((e) => e.id === entry.data.parent)) : undefined;
const paragraphs = (entry.body ?? '').replace(/^##\s*概述\s*$/m, '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const range = { start: entry.data.date.start, end: (entry.data.date.end ?? entry.data.date.start) + 1 };
---
<Base title={entry.data.title}>
  <p class="meta">
    <a href={`${base}/`}>时间轴</a>
    {parent && <> / <a href={`${base}/era/${parent.id}`}>{parent.data.title}</a></>}
    {' '}/ {isEra ? '分期' : '朝代'}
  </p>
  <h1>{entry.data.title}</h1>
  <p class="meta">{formatRange(entry.data.date)}{entry.data.aliases.length > 0 && <> · 又称 {entry.data.aliases.join('、')}</>}</p>
  <section class="overview">{paragraphs.map((p) => <p>{p}</p>)}</section>

  {mine.length > 0 && (
    <Timeline
      range={range}
      filterEra={isEra ? entry.id : undefined}
      filterDynasty={isEra ? undefined : entry.id}
      minimal
    />
  )}

  {children.length > 0 && (
    <>
      <h2>朝代</h2>
      <ul>
        {children.map((d) => (
          <li><a href={`${base}/era/${d.id}`}>{d.data.title}</a> <span class="meta">{formatRange(d.data.date)}</span> — <span class="meta">{d.data.summary}</span></li>
        ))}
      </ul>
    </>
  )}

  <h2>节点（{mine.length}）</h2>
  {mine.length > 0 ? <NodeList nodes={mine} /> : <p class="empty">暂无节点。</p>}
</Base>

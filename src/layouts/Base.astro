---
import { INCLUDE_DRAFTS } from '../lib/publish';
interface Props {
  title: string;
  description?: string;
}
const { title, description = '中国历史时间线：正史、野史、名家批注' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · 史线</title>
    <link rel="stylesheet" href={`${base}/styles/base.css`} />
    <!-- 首屏前应用用户主题选择，避免闪烁（A3） -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('hl-theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {
          /* localStorage 不可用时按系统主题 */
        }
      })();
    </script>
  </head>
  <body>
    {INCLUDE_DRAFTS && <div class="preview-banner">本地预览模式：含未审核（draft）内容，仅本地可见，线上构建自动排除。</div>}
    <header class="site-header">
      <a class="brand" href={`${base}/`}>史线</a>
      <nav>
        <a href={`${base}/`}>时间轴</a>
        <a href={`${base}/search`}>搜索</a>
        <a href={`${base}/about`}>凡例</a>
        <button id="theme-toggle" class="theme-toggle" type="button" title="主题：跟随系统" aria-label="切换亮色 / 暗色 / 跟随系统">
          <span class="tt-icon tt-sun" aria-hidden="true">☀</span>
          <span class="tt-icon tt-moon" aria-hidden="true">☾</span>
        </button>
      </nav>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      内容由 AI 辅助起草、人工审核。未审核（draft）条目仅本地可见。
    </footer>

    <script>
      import { readChoice, applyTheme, cycleTheme } from '../lib/theme';

      const btn = document.getElementById('theme-toggle');
      if (btn) {
        const label = { auto: '跟随系统', light: '亮色', dark: '暗色' } as const;
        const sync = () => {
          const c = readChoice();
          btn.title = `主题：${label[c]}，点击切换`;
          btn.setAttribute('aria-label', btn.title);
        };
        sync();
        btn.addEventListener('click', () => {
          applyTheme(cycleTheme(readChoice()));
          sync();
        });
      }
    </script>
  </body>
</html>